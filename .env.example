# Copy to .env for local development. Do not commit .env.

NODE_ENV=development
API_HOST=localhost
API_PORT=5000

# Generate a long random value and store it only in .env.
# Example PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
API_TOKEN=replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smurti_app
DB_PASSWORD=replace-with-local-db-password
DB_NAME=smurti

# Keep media outside the source repository.
MEDIA_ROOT=D:\SmurtiData\media
MEDIA_MAX_BYTES=524288000

# Local-only Ollama endpoint. Do not expose Ollama to LAN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Local transcription command can be configured later after Whisper is installed.
WHISPER_COMMAND=
